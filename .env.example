# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
#
#   cp .env.example .env

# --- Required: the LLM provider key -----------------------------------------
DEEPSEEK_APIKEY=

# --- Optional: LLM endpoint / behaviour --------------------------------------
# DEEPSEEK_API_BASE=https://api.deepseek.com
# THINKING=true
# REASONING_EFFORT=low
# LLM_MAX_CONCURRENCY=10
# LOGIC_MAX_ATTEMPTS=4

# --- Optional: dashboard runtime knobs (also editable from the 设置 panel) ----
# These are injected into every job subprocess and override src/config.py.
# LLMWORLD_MODEL=deepseek-v4-flash
# LLMWORLD_TEMPERATURE=1.0
# LLMWORLD_MAX_TOKENS=64000
# LLMWORLD_REQUEST_TIMEOUT=600
# LLMWORLD_MAX_RETRIES=3
# LLMWORLD_RETRY_BACKOFF=2

# --- Optional: MCP auth ------------------------------------------------------
# Set to require `Authorization: Bearer <MCP_TOKEN>` on /mcp (default: localhost, no token).
# MCP_TOKEN=

# --- Present in the original .env but currently unused -----------------------
# OPENELECTRICITY_API_KEY=
